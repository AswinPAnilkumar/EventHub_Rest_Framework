# API for RegisterView
###
POST http://127.0.0.1:8000/register/
Content-Type: application/json

{
    "username":"hari",
    "email":"hari@gmail.com",
    "password":"hari@123"
}

#API for UsersListView
###
GET http://127.0.0.1:8000/users/
Accept: application/json

#API for EventCreateView
###
GET http://127.0.0.1:8000/events/
Accept: application/json
Authorization: Basic hari:hari@123

###
POST http://127.0.0.1:8000/events/
Content-Type: application/json
Authorization: Basic hari:hari@123

{
    "title" : "Halloween Celebration",
    "description" : "halloween celebration",
    "date" : "2026-11-05",
    "location" : "Infosys"
}

